{
  "name": "pid-desktop",
  "private": true,
  "version": "0.2.28",
  "license": "Apache-2.0",
  "description": "A local-first Windows desktop client for the Pi coding agent",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Llllviaaaa/PIDesktop.git"
  },
  "bugs": {
    "url": "https://github.com/Llllviaaaa/PIDesktop/issues"
  },
  "homepage": "https://github.com/Llllviaaaa/PIDesktop#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "prepare:pi-runtime": "node scripts/prepare-pi-runtime.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mcp-subscriptions": "node scripts/test-mcp-subscriptions.mjs",
    "test:pi-runtime": "npm run prepare:pi-runtime && node scripts/test-pi-runtime.mjs",
    "test:public-hygiene": "node scripts/test-public-repo-hygiene.mjs",
    "test:doc-links": "node scripts/test-doc-links.mjs",
    "test:github-config": "node scripts/test-github-config.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:unit": "npm run test && npm run test:mcp-subscriptions && npm run test:pi-runtime && npm run test:public-hygiene && npm run test:doc-links && npm run test:github-config"
  },
  "dependencies": {
    "@plantuml/core": "^1.2026.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.17.2",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.1",
    "bun": "1.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "4.23.12",
    "typebox": "^1.3.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.4",
    "vitest": "^5.0.1",
    "yaml": "2.9.0"
  }
}
